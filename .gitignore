# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# base de données locale (régénérée via npm run db:push && npm run db:seed)
/data/*.db
/data/*.db-*

# fichiers uploades (stockage local, voir src/lib/storage.ts)
/storage/uploads/

# tests
/test-results/
/playwright-report/

# captures d ecran de revue design (generees par scripts/captures-biens.mjs)
/docs/captures/

# Résumés du test de charge (npm run charge --json)
perf-resultat*.json
